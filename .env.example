# FFMS environment configuration (example).
# Copy to .env for local development and fill in real values.
# On Render, set these as Environment Variables instead of committing a .env file.
# NEVER commit a real .env — it is git-ignored and must be rotated if it leaks.

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farm_system
DB_USER=postgres
DB_PASS=change_me

# --- Default map centre (latitude / longitude) ---
DEFAULT_LAT=-15.3875
DEFAULT_LON=28.3228

# --- Email / SMTP (used for notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me@example.com
SMTP_PASS=change_me
SMTP_FROM=change_me@example.com
SMTP_FROM_NAME=FFMS

# --- API / cron secrets (MUST be set to long random values in production) ---
JWT_SECRET=change_me_to_a_long_random_string
CRON_SECRET=change_me_to_a_long_random_string
